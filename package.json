{
  "name": "sirdanieliii.ca",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "serve:php": "php -S localhost:8000 -t public",
    "dev": "concurrently \"npm run serve:php\" \"vite\"",
    "predev": "npm run portfolio:compile",
    "photography:generate": "python tools/photography/generate.py",
    "photography:compile": "php tools/photography/compile.php",
    "portfolio:previews": "python tools/portfolio_media/previews.py",
    "portfolio:compile": "php tools/portfolio_media/compile.php --validate && npm run portfolio:previews && php tools/portfolio_media/compile.php",
    "portfolio:test": "php tools/portfolio_media/test_catalog.php",
    "prebuild": "npm run photography:compile && npm run portfolio:compile",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdx-js/rollup": "^3.1.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
